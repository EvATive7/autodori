{
  "interface_version": 2,
  "name": "autodori",
  "label": "$project_name",
  "version": "1.0.21",
  "custom_title": "autodori",
  "url": "https://github.com/EvATive7/autodori",
  "languages": {
    "zh_cn": "interface_zh_cn.json",
    "en_us": "interface_en_us.json"
  },
  "resource": [
    {
      "name": "Default",
      "label": "$resource_default",
      "path": "{PROJECT_DIR}/resource"
    }
  ],
  "controller": [
    {
      "name": "Android",
      "label": "$controller_android",
      "type": "Adb",
      "display_short_side": 720
    }
  ],
  "task": [
    {
      "name": "LaunchGame",
      "label": "$task_launch_game",
      "entry": "LaunchGame",
      "description": "$task_launch_game_description",
      "controller": "Android"
    },
    {
      "name": "AutoLive",
      "label": "$task_auto_live",
      "entry": "AutoLive",
      "description": "$task_auto_live_description",
      "controller": "Android",
      "option": [
        {"name": "Difficulty"},
        {"name": "LiveMode"},
        {"name": "MinimumLiveBoost"}
      ]
    },
    {
      "name": "CloseGame",
      "label": "$task_close_game",
      "entry": "CloseGame",
      "description": "$task_close_game_description",
      "controller": "Android"
    }
  ],
  "option": {
    "Difficulty": {
      "label": "$option_difficulty",
      "default_case": "Hard",
      "cases": [
        {"name": "Easy", "pipeline_override": {"select_difficulty": {"recognition": "OCR", "expected": "简单"}}},
        {"name": "Normal", "pipeline_override": {"select_difficulty": {"recognition": "OCR", "expected": "普通"}}},
        {"name": "Hard", "pipeline_override": {"select_difficulty": {"recognition": "OCR", "expected": "困难"}}},
        {"name": "Expert", "pipeline_override": {"select_difficulty": {"recognition": "OCR", "expected": "专家"}}},
        {"name": "Special", "pipeline_override": {"select_difficulty": {"recognition": "OCR", "expected": "特殊"}}}
      ]
    },
    "LiveMode": {
      "label": "$option_live_mode",
      "default_case": "FreeLive",
      "cases": [
        {"name": "FreeLive", "label": "$live_mode_free", "pipeline_override": {"select_live_mode": {"recognition": "OCR", "expected": "自由演出"}, "back_to_live_home": {"interrupt": ["JumpBack"]}}},
        {"name": "ChallengeLive", "label": "$live_mode_challenge", "pipeline_override": {"select_live_mode": {"recognition": "OCR", "expected": "挑战演出"}, "back_to_live_home": {"interrupt": ["JumpBack"]}}}
      ]
    },
    "MinimumLiveBoost": {
      "type": "input",
      "label": "$option_minimum_live_boost",
      "input": [
        {
          "name": "value",
          "label": "$input_minimum_live_boost",
          "default": "1",
          "pipeline_type": "int",
          "verify": "^\\d+$",
          "pattern_msg": "$validation_non_negative_integer"
        }
      ],
      "pipeline_override": {
        "ensure_liveboost": {
          "custom_action_param": {
            "minimum": "{value}"
          }
        }
      }
    }
  },
  "agent": {
    "child_exec": "{PROJECT_DIR}/agent/autodori-agent.exe",
    "timeout": 300
  }
}
