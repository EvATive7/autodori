{
  "interface_version": 2,
  "name": "autodori",
  "label": "$project_name",
  "version": "1.0.21",
  "custom_title": "autodori",
  "url": "https://github.com/EvATive7/autodori",
  "languages": {
    "zh_cn": "interface_zh_cn.json",
    "en_us": "interface_en_us.json"
  },
  "resource": [
    {
      "name": "Default",
      "label": "$resource_default",
      "path": "{PROJECT_DIR}/resource"
    }
  ],
  "controller": [
    {
      "name": "Android",
      "label": "$controller_android",
      "type": "Adb",
      "display_short_side": 720
    }
  ],
  "task": [
    {
      "name": "LaunchGame",
      "label": "$task_launch_game",
      "entry": "LaunchGame",
      "description": "$task_launch_game_description",
      "controller": "Android"
    },
    {
      "name": "AutoLive",
      "label": "$task_auto_live",
      "entry": "AutoLive",
      "description": "$task_auto_live_description",
      "controller": "Android",
      "option": [
        {"name": "Difficulty"},
        {"name": "LiveMode"},
        {"name": "UnlimitedLive"},
        {"name": "MinimumLiveBoost"}
      ]
    },
    {
      "name": "ClaimRewards",
      "label": "$task_claim_rewards",
      "entry": "ClaimRewards",
      "description": "$task_claim_rewards_description",
      "controller": "Android"
    },
    {
      "name": "CloseGame",
      "label": "$task_close_game",
      "entry": "CloseGame",
      "description": "$task_close_game_description",
      "controller": "Android"
    }
  ],
  "option": {
    "Difficulty": {
      "label": "$option_difficulty",
      "default_case": "Hard",
      "cases": [
        {"name": "Easy", "pipeline_override": {"set_difficulty": {"template": ["live/difficulty/easy_active.png", "live/difficulty/easy_inactive.png"], "target": [659, 495, 107, 97]}, "get_song_name": {"custom_recognition_param": {"difficulty": "easy"}}}},
        {"name": "Normal", "pipeline_override": {"set_difficulty": {"template": ["live/difficulty/normal_active.png", "live/difficulty/normal_inactive.png"], "target": [768, 494, 107, 97]}, "get_song_name": {"custom_recognition_param": {"difficulty": "normal"}}}},
        {"name": "Hard", "pipeline_override": {"set_difficulty": {"template": ["live/difficulty/hard_active.png", "live/difficulty/hard_inactive.png"], "target": [886, 494, 105, 97]}, "get_song_name": {"custom_recognition_param": {"difficulty": "hard"}}}},
        {"name": "Expert", "pipeline_override": {"set_difficulty": {"template": ["live/difficulty/expert_active.png", "live/difficulty/expert_inactive.png"], "target": [996, 493, 107, 97]}, "get_song_name": {"custom_recognition_param": {"difficulty": "expert"}}}},
        {"name": "Special", "pipeline_override": {"set_difficulty": {"template": ["live/difficulty/special_active.png", "live/difficulty/special_inactive.png"], "target": [1086, 449, 192, 184]}, "get_song_name": {"custom_recognition_param": {"difficulty": "special"}}}}
      ]
    },
    "LiveMode": {
      "label": "$option_live_mode",
      "default_case": "FreeLive",
      "cases": [
        {"name": "FreeLive", "label": "$live_mode_free", "pipeline_override": {"select_live_mode": {"recognition": "OCR", "expected": "自由演出", "roi": [679, 183, 257, 354], "action": "Click", "post_delay": 1000, "next": ["select_song", "select_live_mode", "live_home_button", "[JumpBack]login_expired", "[JumpBack]connect_failed"]}}},
        {"name": "ChallengeLive", "label": "$live_mode_challenge", "pipeline_override": {"select_live_mode": {"recognition": "OCR", "expected": "挑战演出", "roi": [679, 183, 257, 354], "action": "Click", "post_delay": 1000, "next": ["select_song", "select_live_mode", "live_home_button", "[JumpBack]login_expired", "[JumpBack]connect_failed"]}}}
      ]
    },
    "UnlimitedLive": {
      "type": "switch",
      "label": "$option_unlimited_live",
      "default_case": "Yes",
      "cases": [
        {"name": "Yes", "label": "$unlimited_live_yes"},
        {"name": "No", "label": "$unlimited_live_no", "option": ["LiveCount"]}
      ]
    },
    "LiveCount": {
      "type": "input",
      "label": "$option_live_count",
      "inputs": [
        {
          "name": "count",
          "label": "$input_live_count",
          "default": "1",
          "pipeline_type": "int",
          "verify": "^[1-9]\\d*$",
          "pattern_msg": "$validation_positive_integer"
        }
      ],
      "pipeline_override": {
        "InitializeRuntime": {
          "custom_action_param": {
            "limit": "{count}"
          }
        }
      }
    },
    "MinimumLiveBoost": {
      "type": "input",
      "label": "$option_minimum_live_boost",
      "inputs": [
        {
          "name": "value",
          "label": "$input_minimum_live_boost",
          "default": "1",
          "pipeline_type": "int",
          "verify": "^\\d+$",
          "pattern_msg": "$validation_non_negative_integer"
        }
      ],
      "pipeline_override": {
        "ensure_liveboost": {
          "custom_action_param": {
            "minimum": "{value}"
          }
        }
      }
    }
  },
  "agent": {
    "child_exec": "{PROJECT_DIR}/agent/autodori-agent.exe",
    "timeout": 300
  }
}
