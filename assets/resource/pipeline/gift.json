        "roi": [500, 550, 300, 120],
        "action": "Click",
        "post_delay": 1000,
        "next": ["return_home_after_claim"]
    },
    "no_claimable_rewards": {
        "recognition": "OCR",
        "expected": "没有可领取的礼物。",
