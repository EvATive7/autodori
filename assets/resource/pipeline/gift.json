        "roi": [350, 40, 600, 100],
        "focus": {
            "Node.Recognition.Succeeded": "$log_rewards_claimed"
        },
        "next": ["confirm_claimed_rewards"]
    },
    "confirm_claimed_rewards": {
        "recognition": "OCR",
