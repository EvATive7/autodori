        "focus": {
            "Node.Recognition.Succeeded": "$log_rewards_empty"
        },
        "next": ["return_home_after_claim"]
    },
    "return_home_after_claim": {
        "recognition": "TemplateMatch",
        "template": "gift/back.png",
        "action": "Click",
        "focus": {
            "Node.Action.Succeeded": "$log_rewards_returning_home"
        },
        "post_delay": 1000,
        "next": ["ClaimRewardsHome"]
    },
    "ClaimRewardsHome": {
        "recognition": "TemplateMatch",
        "template": "home/gift.png",
        "roi": [1180, 210, 100, 90],
        "focus": {
            "Node.Recognition.Succeeded": "$log_rewards_home"
        }
    }
