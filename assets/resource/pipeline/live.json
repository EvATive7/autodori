{
    "AutoLive": {
        "next": ["InitializeRuntime"]
    },
    "InitializeRuntime": {
        "action": "Custom",
        "custom_action": "InitializeRuntime",
        "focus": {
            "Node.Action.Starting": "$log_autolive_initializing",
            "Node.Action.Succeeded": "$log_autolive_started",
            "Node.Action.Failed": "$log_autolive_start_failed"
        },
        "next": [
            "select_song",
            "select_live_mode",
            "live_home_button",
            "[JumpBack]to_tome"
        ]
    },
    "live_home_button": {
        "recognition": "TemplateMatch",
        "template": "live/button/live_home.png",
        "action": "Click",
        "focus": {
            "Node.Action.Succeeded": "$log_live_home_ready"
        },
        "post_delay": 1500,
        "next": [
            "return_to_main_after_limit",
            "select_live_mode",
            "live_home_button",
            "[JumpBack]next_button",
            "[JumpBack]close_button",
            "[JumpBack]donot_usenow_button"
        ]
    },
    "return_to_main_after_limit": {
        "recognition": "Custom",
        "custom_recognition": "LiveLimitReached",
        "focus": {
            "Node.Recognition.Succeeded": "$log_live_limit_reached"
        },
        "next": ["to_tome"]
    },
    "select_live_mode": {
        "recognition": "OCR",
        "expected": "自由演出",
        "roi": [679, 183, 257, 354],
        "action": "Click",
        "focus": {
            "Node.Action.Succeeded": "$log_live_mode_selected"
        },
        "post_delay": 1000,
        "next": [
            "select_song",
            "select_live_mode",
            "live_home_button",
            "[JumpBack]login_expired",
            "[JumpBack]connect_failed"
        ]
    },
    "select_song": {
        "recognition": "OCR",
        "expected": [
            "选择乐曲"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "$log_song_selection_ready"
        },
        "next": [
            "random_choice_song",
            "set_difficulty",
            "select_song",
            "select_live_mode",
            "live_home_button"
        ],
        "post_delay": 2000
    },
    "random_choice_song": {
        "recognition": "TemplateMatch",
        "template": "live/button/random_choice_song.png",
        "action": "Click",
        "focus": {
            "Node.Action.Succeeded": "$log_song_randomized"
        },
        "post_delay": 2000,
        "next": [
            "set_difficulty",
            "random_choice_song",
            "select_song",
            "select_live_mode",
            "live_home_button"
        ]
    },
    "get_song_name": {
        "action": "Custom",
        "recognition": "Custom",
        "custom_recognition": "SongRecognition",
        "custom_recognition_param": {
            "difficulty": "hard"
        },
        "custom_action": "SaveSong",
        "focus": {
            "Node.Action.Succeeded": "$log_song_identified"
        },
        "next": [
            "comfirm_song",
            "[JumpBack]confirm_button"
        ]
    },
    "set_difficulty": {
        "action": "Click",
        "recognition": "TemplateMatch",
        "template": [
            "live/difficulty/hard_active.png",
            "live/difficulty/hard_inactive.png"
        ],
        "next": [
            "get_song_name",
            "[JumpBack]random_choice_song"
        ],
        "target": [886, 494, 105, 97],
        "timeout": 5000,
        "focus": {
            "Node.Action.Succeeded": "$log_difficulty_selected"
        }
    },
    "comfirm_song": {
        "recognition": "OCR",
        "expected": [
            "选择乐队",
            "最终确认"
        ],
        "next": [
            "ensure_liveboost"
        ],
        "timeout": 3000,
        "focus": {
            "Node.Recognition.Succeeded": "$log_team_confirmation_ready"
        },
        "on_error": [
            "close_app"
        ]
    },
    "ensure_live_mode": {
        "recognition": "OCR",
        "expected": [
            "自由演出",
            "挑战演出"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "$log_live_settings_ready"
        },
        "roi": [
            122,
            19,
            158,
            27
        ],
        "next": [
            "disable_liveplay",
            "[JumpBack]switch_liveplay_mode"
        ]
    },
    "exit_rehearsal_mode": {
        "action": "Click",
        "target": [
            29,
            502,
            51,
            48
        ]
    },
    "ensure_liveboost": {
        "recognition": "Custom",
        "custom_recognition": "LiveBoostEnoughRecognition",
        "focus": {
            "Node.Recognition.Succeeded": "$log_liveboost_checked"
        },
        "action": "Custom",
        "custom_action": "HandleLiveBoost",
        "custom_action_param": {
            "minimum": 0
        },
        "next": [
            "open_liveboost_settings",
            "[JumpBack]exit_rehearsal_mode"
        ]
    },
    "open_liveboost_settings": {
        "recognition": "TemplateMatch",
        "template": "live/button/liveboost_settings.png",
        "action": "Click",
        "focus": {
            "Node.Action.Succeeded": "$log_liveboost_settings_opened"
        },
        "post_delay": 500,
        "next": [
            "select_liveboost_consumption",
            "[JumpBack]exit_rehearsal_mode"
        ]
    },
    "liveboost_ten_remaining_ocr": {
        "recognition": "OCR",
        "only_rec": true,
        "roi": [920, 470, 130, 35]
    },
    "select_liveboost_consumption": {
        "recognition": "Custom",
        "custom_recognition": "LiveBoostConsumptionRecognition",
        "custom_recognition_param": {
            "consumption": "auto"
        },
        "action": "Custom",
        "custom_action": "ApplyLiveBoostConsumption",
        "focus": {
            "Node.Action.Succeeded": "$log_liveboost_consumption_applied"
        },
        "post_delay": 300,
        "next": [
            "confirm_liveboost_settings",
            "[JumpBack]exit_rehearsal_mode"
        ]
    },
    "confirm_liveboost_settings": {
        "recognition": "OCR",
        "expected": "OK",
        "roi": [520, 605, 224, 70],
        "action": "Click",
        "focus": {
            "Node.Action.Succeeded": "$log_liveboost_settings_confirmed"
        },
        "post_delay": 500,
        "next": [
            "ensure_live_mode",
            "[JumpBack]exit_rehearsal_mode"
        ]
    },
    "switch_liveplay_mode": {
        "action": "Click",
        "target": [
            125,
            631,
            33,
            35
        ],
        "focus": {
            "Node.Action.Succeeded": "$log_liveplay_mode_switched"
        }
    },
    "disable_liveplay": {
        "recognition": "TemplateMatch",
        "template": [
            "live/button/liveplay_3d.png",
            "live/button/liveplay_mv.png"
        ],
        "inverse": true,
        "focus": {
            "Node.Recognition.Succeeded": "$log_liveplay_mode_ready"
        },
        "next": ["startlive"],
        "roi": [
            58,
            580,
            363,
            140
        ]
    },
    "startlive": {
        "action": "Click",
        "recognition": "TemplateMatch",
        "template": "live/button/startlive.png",
        "focus": {
            "Node.Action.Starting": "$log_live_starting",
            "Node.Action.Succeeded": "$log_live_start_clicked",
            "Node.Action.Failed": "$log_live_start_failed"
        },
        "next": [
            "wait_live_start",
            "[JumpBack]startlive",
            "[JumpBack]confirm_button",
            "[JumpBack]login_expired",
            "[JumpBack]connect_failed"
        ],
        "post_delay": 2000
    },
    "wait_live_start": {
        "recognition": "TemplateMatch",
        "template": "live/button/pause.png",
        "focus": {
            "Node.Recognition.Succeeded": "$log_live_started"
        },
        "next": ["playsong"]
    },
    "playsong": {
        "action": "Custom",
        "custom_action": "Play",
        "focus": {
            "Node.Action.Starting": "$log_playing_song",
            "Node.Action.Succeeded": "$log_song_played",
            "Node.Action.Failed": "$log_song_play_failed"
        },
        "next": [
            "wait_playresult",
            "[JumpBack]live_failed",
            "[JumpBack]next_button",
            "[JumpBack]close_button",
            "[JumpBack]ok_button",
            "[JumpBack]confirm_button",
            "[JumpBack]login_expired",
            "[JumpBack]connect_failed"
        ]
    },
    "wait_playresult": {
        "recognition": "TemplateMatch",
        "template": [
            "live/scored.png",
            "live/activity_scored.png"
        ],
        "next": [
            "wait_playresult1",
            "[JumpBack]next_button",
            "[JumpBack]close_button",
            "[JumpBack]ok_button",
            "[JumpBack]confirm_button"
        ],
        "pre_wait_freezes": {
            "threshold": 0.65,
            "time": 5000
        },
        "post_delay": 3000
    },
    "wait_playresult1": {
        "recognition": "TemplateMatch",
        "template": [
            "live/scored.png",
            "live/activity_scored.png"
        ],
        "pre_wait_freezes": 2000,
        "next": ["save_succeed_playresult"]
    },
    "save_succeed_playresult": {
        "recognition": "Custom",
        "custom_recognition": "PlayResultRecognition",
        "action": "Custom",
        "custom_action": "SavePlayResult",
        "focus": {
            "Node.Action.Succeeded": "$log_live_result_saved"
        },
        "custom_action_param": {
            "succeed": true
        },
        "next": [
            "live_home_button",
            "[JumpBack]next_button",
            "[JumpBack]close_button",
            "[JumpBack]ok_button",
            "[JumpBack]confirm_button",
            "[JumpBack]reader_menu",
            "[JumpBack]read_after"
        ]
    },
    "liveagain": {
        "recognition": "TemplateMatch",
        "template": "live/button/liveagain.png",
        "action": "Click",
        "next": ["select_song"]
    },
    "live_failed": {
        "recognition": "OCR",
        "expected": "演出失败",
        "focus": {
            "Node.Recognition.Succeeded": "$log_live_failed"
        },
        "roi": [
            256,
            227,
            155,
            38
        ],
        "next": [
            "save_failed_playresult",
            "exit_button",
            "[JumpBack]login_expired",
            "[JumpBack]connect_failed"
        ]
    },
    "save_failed_playresult": {
        "action": "Custom",
        "custom_action": "SavePlayResult",
        "focus": {
            "Node.Action.Succeeded": "$log_failed_live_result_saved"
        },
        "custom_action_param": {
            "succeed": false
        },
        "next": [
            "live_home_button",
            "[JumpBack]exit_button"
        ]
    }
}
